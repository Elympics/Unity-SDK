.elympics-header {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 6px;
    -unity-text-align: middle-center;
}

.elympics-header-line {
    height: 1px;
    margin-bottom: 4px;
    background-color: rgb(46, 172, 255);
}

.elympics-info {
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 2px;
}

.elympics-centered {
    -unity-text-align: middle-center;
}

.elympics-centered-field {
    width: 200px;
    align-self: center;
    margin-bottom: 2px;
}

.elympics-centered-field .unity-base-text-field__input,
.elympics-centered-field .unity-text-element {
    -unity-text-align: middle-center;
}

.elympics-centered-button {
    width: 150px;
    height: 30px;
    align-self: center;
    margin-top: 5px;
    margin-bottom: 5px;
}

.elympics-wide-button {
    width: 80%;
    height: 20px;
    align-self: center;
    margin-top: 2px;
    margin-bottom: 2px;
}

.elympics-account-game-row {
    flex-direction: row;
}

.elympics-account-game-row .elympics-account-game-name {
    width: 35%;
}

.elympics-account-game-row .elympics-account-game-id {
    flex-grow: 1;
}

.elympics-endpoint-row,
.elympics-field-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.elympics-endpoint-label,
.elympics-field-label {
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

.elympics-endpoint-label {
    width: 30%;
}

.elympics-field-label {
    width: 25%;
}

.elympics-endpoint-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 0;
    margin-right: 0;
}

.elympics-endpoint-status {
    width: 20%;
    min-width: 90px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
}

/* Sections of the embedded ElympicsGameConfigEditor inspector that the 'Manage Games...' window does not display. */
.compact-game-config #max-players,
.compact-game-config #webrtc-toggle,
.compact-game-config #connection-config,
.compact-game-config #game-loop-foldout,
.compact-game-config #debug-foldout,
.compact-game-config .separator {
    display: none;
}
